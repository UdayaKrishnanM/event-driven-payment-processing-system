<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared by all services (included from each logback-spring.xml). %maskedMsg masks any card number in log lines. -->
<included>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <conversionRule conversionWord="maskedMsg" converterClass="com.payments.common.logging.CardMaskingConverter"/>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="app"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [${APP_NAME}] [%15.15t] %-40.40logger{39} : %maskedMsg%n%wEx</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.kafka.listener" level="INFO"/>
</included>
