    {
      "name": "1. Payment happy path + idempotency",
      "item": [
        {
          "name": "Create payment (approved card)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{paymentUrl}}/api/v1/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"{{merchantId}}\",\n  \"cardNumber\": \"4111111111111111\",\n  \"expiryMonth\": 12,\n  \"expiryYear\": 2030,\n  \"amount\": 2499.00,\n  \"currency\": \"INR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Returns 202 immediately. Authorization -> ledger -> settlement then happen asynchronously over Kafka."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh merchant + idempotency key for every run, so results never mix with older runs",
                  "pm.collectionVariables.set('merchantId', 'MER-PM-' + Math.floor(Math.random() * 1e6));",
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const json = pm.response.json();",
                  "pm.test('status RECEIVED', () => pm.expect(json.status).to.eql('RECEIVED'));",
                  "pm.test('card is masked', () => pm.expect(json.maskedCard).to.eql('**** 1111'));",
                  "pm.test('full card number never returned', () => pm.expect(pm.response.text()).to.not.include('4111111111111111'));",
                  "pm.test('Location header', () => pm.expect(pm.response.headers.get('Location')).to.include(json.paymentId));",
                  "pm.collectionVariables.set('paymentId', json.paymentId);",
                  "pm.collectionVariables.set('firstResponse', pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "Send the SAME request again (replay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{paymentUrl}}/api/v1/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"{{merchantId}}\",\n  \"cardNumber\": \"4111111111111111\",\n  \"expiryMonth\": 12,\n  \"expiryYear\": 2030,\n  \"amount\": 2499.00,\n  \"currency\": \"INR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Same Idempotency-Key + same body: no new payment, the stored response is returned."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('same paymentId', () => pm.expect(pm.response.json().paymentId).to.eql(pm.collectionVariables.get('paymentId')));",
                  "pm.test('Idempotent-Replayed: true', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));",
                  "pm.test('identical body', () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('firstResponse')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Same key, DIFFERENT body -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{paymentUrl}}/api/v1/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"{{merchantId}}\",\n  \"cardNumber\": \"4111111111111111\",\n  \"expiryMonth\": 12,\n  \"expiryYear\": 2030,\n  \"amount\": 1.00,\n  \"currency\": \"INR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));",
                  "pm.test('code IDEMPOTENCY_KEY_REUSED', () => pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_KEY_REUSED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get payment (poll until SETTLED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{paymentUrl}}/api/v1/payments/{{paymentId}}",
            "description": "In the Collection Runner this repeats until SETTLED. Sending manually: click Send again after a second."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 1000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const attempts = Number(pm.collectionVariables.get('pollAttempts') || 0);",
                  "if (json.status !== 'SETTLED' && attempts < 20) {",
                  "    pm.collectionVariables.set('pollAttempts', attempts + 1);",
                  "    console.log('status is ' + json.status + ', polling again (' + (attempts + 1) + ')');",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "    return;",
                  "}",
                  "pm.collectionVariables.set('pollAttempts', 0);",
                  "pm.test('status is SETTLED', () => pm.expect(json.status).to.eql('SETTLED'));",
                  "",
                  "pm.test('has 6-char auth code', () => pm.expect(json.authCode).to.match(/^[A-Z0-9]{6}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "List merchant payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{paymentUrl}}/api/v1/payments?merchantId={{merchantId}}&page=0&size=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('contains our payment', () => pm.expect(pm.response.json().content.map(p => p.paymentId)).to.include(pm.collectionVariables.get('paymentId')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Ledger (double entry)",
      "item": [
        {
          "name": "Entries for the payment (DEBIT + CREDIT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ledgerUrl}}/api/v1/ledger/payments/{{paymentId}}/entries"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('exactly 2 entries', () => pm.expect(json.entries.length).to.eql(2));",
                  "pm.test('balanced', () => pm.expect(json.balanced).to.be.true);",
                  "const accounts = json.entries.map(e => e.direction + ' ' + e.account);",
                  "pm.test('DEBIT CUSTOMER_CLEARING', () => pm.expect(accounts).to.include('DEBIT CUSTOMER_CLEARING'));",
                  "pm.test('CREDIT MERCHANT:<id>', () => pm.expect(accounts).to.include('CREDIT MERCHANT:' + pm.collectionVariables.get('merchantId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Merchant balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ledgerUrl}}/api/v1/ledger/merchants/{{merchantId}}/balance"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json().balances.find(x => x.currency === 'INR');",
                  "pm.test('balance is 2499.00', () => pm.expect(b.balance).to.eql(2499.00));"
                ]
              }
            }
          ]
        },
        {
          "name": "Trial balance (all debits = all credits)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ledgerUrl}}/api/v1/ledger/trial-balance"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ledger balanced', () => pm.expect(pm.response.json().balanced).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
