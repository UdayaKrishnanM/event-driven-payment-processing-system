    {
      "name": "5. Notifications",
      "item": [
        {
          "name": "Notifications for merchant",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{notificationUrl}}/api/v1/notifications?merchantId={{merchantId}}&size=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const types = pm.response.json().content.map(n => n.type);",
                  "pm.test('authorized notification', () => pm.expect(types).to.include('PAYMENT_AUTHORIZED'));",
                  "pm.test('settled notification', () => pm.expect(types).to.include('PAYMENT_SETTLED'));",
                  "pm.test('declined notification', () => pm.expect(types).to.include('PAYMENT_DECLINED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Notifications for one payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{notificationUrl}}/api/v1/notifications?paymentId={{paymentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('authorized + settled', () => pm.expect(pm.response.json().totalElements).to.eql(2));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Retries + dead-letter topic + replay",
      "item": [
        {
          "name": "Turn chaos ON for MER-DLT-DEMO",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ledgerUrl}}/api/v1/admin/chaos",
            "body": {
              "mode": "raw",
              "raw": "{\"failMerchantId\": \"MER-DLT-DEMO\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "From now on the ledger consumer throws for this merchant. Watch: docker compose logs -f ledger-service"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('enabled', () => pm.expect(pm.response.json().enabled).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create payment for MER-DLT-DEMO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{paymentUrl}}/api/v1/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"MER-DLT-DEMO\",\n  \"cardNumber\": \"4242424242424242\",\n  \"expiryMonth\": 12,\n  \"expiryYear\": 2030,\n  \"amount\": 77.00,\n  \"currency\": \"INR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('dltPaymentId', pm.response.json().paymentId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Failed events (poll until our payment is on the DLT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{notificationUrl}}/api/v1/admin/failed-events?size=50",
            "description": "Takes ~8 s: 1 try + 3 retries at 1 s, 2 s, 4 s, then the DLT."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const mine = pm.response.json().content.find(f => f.key === pm.collectionVariables.get('dltPaymentId'));",
                  "const attempts = Number(pm.collectionVariables.get('pollAttempts') || 0);",
                  "if (!mine && attempts < 15) {",
                  "    pm.collectionVariables.set('pollAttempts', attempts + 1);",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "    return;",
                  "}",
                  "pm.collectionVariables.set('pollAttempts', 0);",
                  "pm.test('payment landed on payment.authorized.DLT', () => {",
                  "    pm.expect(mine).to.exist;",
                  "    pm.expect(mine.topic).to.eql('payment.authorized.DLT');",
                  "    pm.expect(mine.consumerGroup).to.eql('ledger-service');",
                  "});",
                  "if (mine) { pm.collectionVariables.set('failedEventId', mine.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment is stuck in AUTHORIZED (not settled)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{paymentUrl}}/api/v1/payments/{{dltPaymentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('AUTHORIZED', () => pm.expect(pm.response.json().status).to.eql('AUTHORIZED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Turn chaos OFF (the 'fix')",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ledgerUrl}}/api/v1/admin/chaos",
            "body": {
              "mode": "raw",
              "raw": "{\"failMerchantId\": null}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('disabled', () => pm.expect(pm.response.json().enabled).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay the failed event",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{notificationUrl}}/api/v1/admin/failed-events/{{failedEventId}}/replay"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('replayed', () => pm.expect(pm.response.json().replayCount).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment now SETTLED (poll)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{paymentUrl}}/api/v1/payments/{{dltPaymentId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 1000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const attempts = Number(pm.collectionVariables.get('pollAttempts') || 0);",
                  "if (json.status !== 'SETTLED' && attempts < 20) {",
                  "    pm.collectionVariables.set('pollAttempts', attempts + 1);",
                  "    console.log('status is ' + json.status + ', polling again (' + (attempts + 1) + ')');",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "    return;",
                  "}",
                  "pm.collectionVariables.set('pollAttempts', 0);",
                  "pm.test('status is SETTLED', () => pm.expect(json.status).to.eql('SETTLED'));"
                ]
              }
            }
          ]
        }
      ]
    },
