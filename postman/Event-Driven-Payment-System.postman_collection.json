                  "const n = Number(pm.collectionVariables.get('velocityCount')) + 1;",
                  "pm.collectionVariables.set('velocityCount', n);",
                  "if (n < 6) { pm.execution.setNextRequest(pm.info.requestName); } else { pm.collectionVariables.set('velocityCount', 0); }"
                ]
              }
            }
